# Paths used by the Rust daemon.
FILTERD_SOCKET=/run/jellyfin-content-filter/filterd.sock
FILTERD_DATABASE=/var/lib/jellyfin-content-filter/filterd.sqlite3
FILTERD_FFPROBE=/usr/bin/ffprobe
FILTERD_FFMPEG=/usr/bin/ffmpeg

# Generate a long random value and configure the same value in the Jellyfin plugin.
FILTERD_AUTH_TOKEN=REPLACE_ME

# Keep analysis bounded so Jellyfin transcoding retains access to the Intel GPU.
FILTERD_ANALYSIS_CONCURRENCY=1
FILTERD_FRAME_INTERVAL_SECONDS=5
FILTERD_MAX_REQUEST_BYTES=1048576
FILTERD_OPENVINO_DEVICE=GPU

# Balanced GPU use: Whisper + OpenVINO share the Intel GPU when Jellyfin is idle.
# FILTERD_WHISPER_GPU_LAYERS=99
# FILTERD_WHISPER_OPENVINO_DEVICE=GPU

# Optional scheduling: only drain the queue inside this local-time window (HH:MM-HH:MM).
# FILTERD_ANALYSIS_WINDOW=22:00-06:00

# Yield analysis while Jellyfin has active transcode sessions (requires an API key).
# FILTERD_JELLYFIN_URL=http://127.0.0.1:8096
# FILTERD_JELLYFIN_API_KEY=
# FILTERD_YIELD_POLL_SECONDS=30

# Optional administrator-installed tools and audited model weights.
# FILTERD_WHISPER_EXECUTABLE=/usr/lib/jellyfin-content-filter/whisper-cli
# FILTERD_WHISPER_MODEL=/var/lib/jellyfin-content-filter/models/ggml-base.en.bin
# FILTERD_OPENVINO_RUNNER=/usr/lib/jellyfin-content-filter/openvino-runner
# FILTERD_OPENVINO_MODEL=/var/lib/jellyfin-content-filter/models/content-safety.xml
# Sibling content-safety.bin is loaded automatically for IR models.
# FILTERD_OPENVINO_LABELS=/var/lib/jellyfin-content-filter/models/labels.json
# Example: convert cloaked1/nsfw-classifier-ONNX-bucket onnx/model_fp16.onnx with ovc,
# then use crates/openvino-runner/examples/labels-giacomoarienti-5class.json

# Comma-separated terms and optional regular expressions. Populate for your language.
# Default word list: better-profane-words (packaging/data/profanity-words.json).
# FILTERD_PROFANITY_WORDS=/usr/lib/jellyfin-content-filter/profanity-words.json
# FILTERD_PROFANITY_MIN_INTENSITY=1
FILTERD_PROFANITY_TERMS=
FILTERD_PROFANITY_PATTERNS=
# Journal output: info for processing progress, debug for per-enqueue details.
RUST_LOG=filterd=info
