# Paths used by the Rust daemon.
FILTERD_SOCKET=/run/jellyfin-content-filter/filterd.sock
FILTERD_DATABASE=/var/lib/jellyfin-content-filter/filterd.sqlite3
FILTERD_FFPROBE=/usr/bin/ffprobe
FILTERD_FFMPEG=/usr/bin/ffmpeg

# Generate a long random value and configure the same value in the Jellyfin plugin.
FILTERD_AUTH_TOKEN=REPLACE_ME

# Keep analysis bounded so Jellyfin transcoding retains access to the Intel GPU.
FILTERD_ANALYSIS_CONCURRENCY=1
FILTERD_FRAME_INTERVAL_SECONDS=5
FILTERD_MAX_REQUEST_BYTES=1048576
FILTERD_OPENVINO_DEVICE=GPU

# Optional administrator-installed tools and audited model weights.
# FILTERD_WHISPER_EXECUTABLE=/opt/whisper.cpp/whisper-cli
# FILTERD_WHISPER_MODEL=/var/lib/jellyfin-content-filter/models/ggml-base.en.bin
# FILTERD_OPENVINO_RUNNER=/opt/jellyfin-content-filter/openvino-runner
# FILTERD_OPENVINO_MODEL=/var/lib/jellyfin-content-filter/models/content-safety.xml

# Comma-separated terms and optional regular expressions. Populate for your language.
FILTERD_PROFANITY_TERMS=
FILTERD_PROFANITY_PATTERNS=
RUST_LOG=filterd=info
