{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "useDefineForClassFields": true,
    "skipLibCheck": true,
    "types": ["vitest/globals"]
  },
  "include": [
    "web/src",
    "web/test",
    "desktop/src",
    "desktop/test",
    "vite.config.ts",
    "vite.desktop.config.ts",
    "eslint.config.js"
  ]
}
