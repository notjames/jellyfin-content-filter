#!/usr/bin/env bash

V=${1:?"usage: $0 <version>"}
UG='jellyfin:jellyfin'

this()
{
  install -m 0755 target/release/filterd /usr/lib/jellyfin-content-filter/filterd
  install -m 0644 packaging/systemd/jellyfin-content-filter.service \
                     /usr/lib/systemd/system/jellyfin-content-filter.service
  chown -R jellyfin:jellyfin /var/lib/jellyfin-content-filter
# unzip plugin DLL into /var/lib/jellyfin/plugins/Content\ Filter_0.1.3/
  DOTNET=dotnet10 VERSION="$V" packaging/scripts/package-plugin.sh
  mkdir -p /var/lib/jellyfin/plugins/Content\ Filter_"$V" && \
    cp dist/jellyfin-content-filter-plugin-${V}.zip /var/lib/jellyfin/plugins/Content\ Filter_"$V"/ && \
    unzip /var/lib/jellyfin/plugins/Content\ Filter_"$V"/jellyfin-content-filter-plugin-${V}.zip -d /var/lib/jellyfin/plugins/Content\ Filter_"$V"/ && \
    rm /var/lib/jellyfin/plugins/Content\ Filter_"$V"/jellyfin-content-filter-plugin-${V}.zip
  chown -R "$UG" "/var/lib/jellyfin/plugins/Content Filter_$V"
  systemctl daemon-reload
  systemctl restart jellyfin-content-filter jellyfin
}

[[ $EUID -ne 0 ]] && \
  {
    echo >&2 'This script must be run as root'
    exit 1
  }

this

