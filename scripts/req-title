#!/usr/bin/env bash

set -eo pipefail

# token should be stored in ~/.config/jellyfin/token
tkf="$HOME/.config/jellyfin/token"
token="$(< "$tkf")"
endpoint='http://127.0.0.1:8096'
title_id="${1:?"Usage: $0 <title id>"}"

[[ -z "$token" ]] && \
{
  echo >&2 "not able to read token file: '$tkf'"
  exit 1
}

curl -Ls -X POST "$endpoint/ContentFilter/analysis" \
  -H "X-Emby-Token: $token" \
  -H 'Content-Type: application/json' \
  -d '{"itemId":"$title_id","force":true}' | jq .
